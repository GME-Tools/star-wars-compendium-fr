{
  "name": "star-wars-compendium-fr",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "fvtt:configure": "fvtt configure",
    "fvtt:status": "fvtt package",
    "fvtt:workon": "fvtt package workon star-wars-compendium-fr --type Module",
    "unpack:carrieres": "fvtt package unpack carrieres --outputDirectory src/packs/carrieres",
    "unpack:talents": "fvtt package unpack talents --outputDirectory src/packs/talents",
    "unpack:livres": "fvtt package unpack livres --outputDirectory src/packs/livres",
    "pack:carrieres": "fvtt package pack carrieres --inputDirectory src/packs/carrieres --outputDirectory packs",
    "pack:talents": "fvtt package pack talents --inputDirectory src/packs/talents --outputDirectory packs",
    "pack:livres": "fvtt package pack livres --inputDirectory src/packs/livres --outputDirectory packs",
    "validate": "node build/validation/validate.mjs",
    "build": "npm run validate && node build/build-all.mjs"
  },
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^3.0.3",
    "html-validate": "^9.3.0",
    "pngjs": "^7.0.0"
  }
}

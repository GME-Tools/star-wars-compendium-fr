    {
      "sort": 200000,
      "name": "Livret d'Aventure",
      "type": "text",
      "_id": "EfW2X6sLPMebPMa6",
      "system": {},
      "title": {
        "show": true,
        "level": 1
      },
      "image": {},
      "text": {
        "format": 1,
        "content": "<h1>Bienvenue dans le Kit d'Initiation de <em>Star Wars</em></h1><h3>Qu'est-ce qu'un Jeu de Rôle ?</h3><h3>Avant de commencer</h3><h4>Un des joueurs est le Maître du Jeu</h4><h4>Les autres personnages sont les Héros</h4><h1>Contenu de cette boîte</h1><h1>Star Wars : Aux Confins de l'Empire</h1><h1>Utilisation de ce livret</h1><h2>Les Personnages Joueurs</h2><h1>Bienvenue à Mos Shuuta</h1><h2>Le plan</h2><h3>Structure de l'aventure</h3><h1>L'aventure commence</h1><h1>Rencontre 1 : En cavale</h1><h1>Rencontre 2 : Un groupe de gamoréens</h1><h1>Rencontre 3 : Le bric-à-brac</h1><h1>Rencontre 4 : Centre de contrôle</h1><h1>Entracte : Expérience et Destin</h1><h1>Rencontre 5 : Les Stormtroopers</h1><h1>Rencontre 6 : Tout le monde à bord</h1><h1>Rencontre 7 : Courage, Fuyons !</h1><h1>Autres aventures à Mos Shuuta</h1><h1>Coupez !</h1><h2>Butin et crédits</h2><h2>Expérience</h2><h3>Remise des Points d'Expérience</h3><h1>Autres aventures : Inspiration</h1><h1>Autres aventures : La Galaxie de Star Wars</h1><h2>Une galaxie d'offre à vous</h2><h2>Une galaxie en guerre</h2><h2>Une galaxie riche en possibilités</h2><h1>Autres aventures : Conseils au MJ</h1><h2>N'interrompez pas l'aventure à cause d'un test raté</h2><h2>Déléguer</h2><h2>Dites « oui » et « oui…mais »</h2><h2>Traiter les autres joueurs comme des alliés</h2>"
      },

    "itemmodifier": [
      {
        "name": "Brèche",
        "type": "itemmodifier",
        "_id": "JFyZPdNrXSG7x2vV",
        "img": "icons/svg/item-bag.svg",
        "system": {
          "description": "<p>Les attaques port&eacute;es &agrave; l'aide d'armes dot&eacute;es de l'attribut Br&egrave;che traversent les armures et les blindages les plus r&eacute;sistants. Le plus souvent, elles sont l'apanage des armes lourdes et des vaisseaux.</p>\n<p>Les attaques port&eacute;es au moyen d'armes de Br&egrave;che ignorent 1 point de blindage (et donc 10 points d'encaissements) par niveau d'attribut.</p>",
